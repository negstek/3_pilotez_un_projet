{
  "name": "@datashare/shared-lib",
  "version": "0.0.1",
  "description": "Types and validation rules shared by the DataShare back-end and front-end",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "oxlint --type-aware src",
    "test": "vitest run"
  },
  "devDependencies": {
    "oxlint": "^1.87.0",
    "prettier": "^3.4.2",
    "typescript": "^6.0.2",
    "vitest": "^5.0.3"
  }
}
