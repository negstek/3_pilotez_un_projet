# Copy this file to `.env`. Only variables prefixed with VITE_ are exposed to
# the browser code (import.meta.env), and their values end up in the bundle:
# never put a secret here.

# Base URL of the back-end API used by the front: the same-origin /api prefix,
# proxied to NestJS by the Vite dev server (see vite.config.ts).
VITE_API_URL=/api
