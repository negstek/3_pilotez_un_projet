{
  "name": "front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "dev:e2e": "FRONT_PORT=8081 API_PROXY_TARGET=http://localhost:3001 vite",
    "cypress:run": "env -u ELECTRON_RUN_AS_NODE cypress run",
    "cypress:open": "env -u ELECTRON_RUN_AS_NODE cypress open",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"cypress/**/*.ts\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"cypress/**/*.ts\" \"*.ts\""
  },
  "dependencies": {
    "@datashare/shared-lib": "*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "cypress": "^16.1.1",
    "jsdom": "^30.1.2",
    "msw": "^2.15.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
