# Copy this file to `.env` and adjust it. `.env` is git-ignored.

# Connection URL of the PostgreSQL database started by docker-compose (at the
# repository root); must match the credentials of the root `.env`.
DATABASE_URL="postgresql://datashare:datashare@localhost:5432/datashare?schema=public"

# HTTP port of the API. The API speaks plain HTTP: browsers reach it in HTTPS
# through the Vite dev server proxy (/api), see front/vite.config.ts.
PORT=3000

# Secret used to sign the JWTs. Use a long random value, e.g. the output of
# `openssl rand -hex 32`; anyone who knows it can forge tokens.
JWT_SECRET=change-me
# Lifetime of the JWT (vercel/ms format: 1h, 1d…). There is no refresh token:
# the user logs in again once it expires.
JWT_EXPIRES_IN=1d
# Public URL of the front (the Vite dev server, in HTTPS), base of the download
# links sent to users (<FRONT_URL>/f/<token>).
FRONT_URL=https://localhost:8080
# Directory of the uploaded files (relative to back/ unless absolute); created
# at startup. Uploads in progress are written to its tmp/ subdirectory.
STORAGE_DIR=storage
# Minimum level of the logs (trace, debug, info, warn, error, fatal, silent).
LOG_LEVEL=info
# Output of the logs: one JSON line per event by default (production, analysis
# with jq), or `pretty` for a readable output in development.
LOG_FORMAT=pretty
