# Configuration of the e2e tests (npm run test:e2e). Committed on purpose: it
# holds no real secret. It targets a dedicated "datashare_test" database on the
# docker-compose PostgreSQL, created and migrated by test/global-setup.ts and
# emptied before each test, so development data is never touched.
DATABASE_URL="postgresql://datashare:datashare@localhost:5432/datashare_test"
JWT_SECRET=e2e-test-secret
JWT_EXPIRES_IN=1h
# Separate from the development storage; emptied by the e2e tests.
STORAGE_DIR=storage-test
