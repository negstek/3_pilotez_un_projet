{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug back (NestJS)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:debug"],
      "cwd": "${workspaceFolder}/back",
      "console": "integratedTerminal",
      "restart": true,
      "autoAttachChildProcesses": true,
      "preLaunchTask": "debug back: prepare",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Debug front (Chrome)",
      "url": "https://localhost:8080",
      // The dev server uses a self-signed certificate (front/vite.config.ts): this dedicated debug browser
      // accepts it instead of showing the security warning at each launch.
      "runtimeArgs": ["--ignore-certificate-errors"],
      "webRoot": "${workspaceFolder}/front",
      "preLaunchTask": "debug front: prepare"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug tests back : fichier courant",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "${file}"],
      "cwd": "${workspaceFolder}/back",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "smartStep": true,
      "preLaunchTask": "shared-lib: build",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug tests e2e back : fichier courant",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "--config", "vitest.config.e2e.ts", "${file}"],
      "cwd": "${workspaceFolder}/back",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "smartStep": true,
      "preLaunchTask": "debug e2e: prepare",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug tests front : fichier courant",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "${file}"],
      "cwd": "${workspaceFolder}/front",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "smartStep": true,
      "preLaunchTask": "shared-lib: build",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ],
  "compounds": [
    {
      "name": "Debug back + front",
      "configurations": ["Debug back (NestJS)", "Debug front (Chrome)"]
    }
  ]
}
