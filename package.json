{
  "name": "datashare",
  "private": true,
  "description": "DataShare monorepo: NestJS back-end, React front-end and the package they share",
  "workspaces": [
    "shared_lib",
    "back",
    "front"
  ],
  "scripts": {
    "postinstall": "npm run build -w @datashare/shared-lib",
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "msw": false
  }
}
